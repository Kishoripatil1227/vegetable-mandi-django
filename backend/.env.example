# Copy to backend/.env and fill in. Never commit the real file.
DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Supabase -> Project Settings -> Database -> Connection string (use "Session pooler")
# Replace [YOUR-PASSWORD]; if the password has special characters, URL-encode them.
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
